<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7F4">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/softHijau"
            android:elevation="4dp"
            app:title="Edit Posko"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Data Posko"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Perbarui informasi posko bencana"
                    android:textSize="14sp"
                    android:textColor="#7F8C8D"/>

            </LinearLayout>

            <!-- Card Form -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Field Nama Posko -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#5CB892"/>

                        <EditText
                            android:id="@+id/etNamaPosko"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nama Posko"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:textColorHint="#95A5A6"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:inputType="text"/>

                    </LinearLayout>

                    <!-- Field Alamat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#5CB892"
                            android:layout_gravity="top"
                            android:layout_marginTop="4dp"/>

                        <EditText
                            android:id="@+id/etAlamat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:gravity="top"
                            android:hint="Alamat Lengkap"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:textColorHint="#95A5A6"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:inputType="textMultiLine"/>

                    </LinearLayout>

                    <!-- Field Kapasitas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            app:tint="#5CB892"/>

                        <EditText
                            android:id="@+id/etKapasitas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Kapasitas (contoh: 500 Orang)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:textColorHint="#95A5A6"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:inputType="text"/>

                    </LinearLayout>

                    <!-- Field Penanggung Jawab -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="#5CB892"/>

                        <EditText
                            android:id="@+id/etPenanggungJawab"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Penanggung Jawab"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:textColorHint="#95A5A6"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:inputType="text"/>

                    </LinearLayout>

                    <!-- Field Telepon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_background"
                        android:padding="12dp"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="#5CB892"/>

                        <EditText
                            android:id="@+id/etTelepon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nomor Telepon"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:textColorHint="#95A5A6"
                            android:background="@android:color/transparent"
                            android:paddingStart="12dp"
                            android:inputType="phone"/>

                    </LinearLayout>

                    <!-- Tombol Simpan -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSimpan"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="💾  Simpan Perubahan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/softHijau"
                        app:cornerRadius="16dp"
                        app:elevation="4dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="#5CB892"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Pastikan data yang diubah sudah benar sebelum disimpan"
                        android:textSize="13sp"
                        android:textColor="#2C3E50"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>